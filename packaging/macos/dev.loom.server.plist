<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by Loom native installer -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.loom.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/Loom/bin/loom</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Library/Application Support/Loom/config/loom.yaml</string>
  </array>
  <key>UserName</key><string>_loom</string>
  <key>GroupName</key><string>_loom</string>
  <key>WorkingDirectory</key><string>/Library/Application Support/Loom/data</string>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>/Library/Application Support/Loom/data</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>120</integer>
  <key>Umask</key><integer>23</integer>
  <key>StandardOutPath</key><string>/Library/Logs/Loom/loom.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/Loom/loom-error.log</string>
</dict>
</plist>
